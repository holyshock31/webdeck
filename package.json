{
  "name": "webdeck",
  "productName": "WebDeck",
  "version": "0.1.19",
  "description": "通用桌面网页包装器：通过 URL 添加应用，支持本地命令启动方式与健康监测。跨平台（macOS / Windows / Linux）。",
  "type": "module",
  "main": "src/main/index.js",
  "private": true,
  "scripts": {
    "start": "bash scripts/dev.sh",
    "smoke": "electron . --smoke",
    "test": "node scripts/test-core.js",
    "e2e": "node e2e/run.cjs",
    "dist": "electron-builder",
    "dist:mac": "electron-builder --mac",
    "dist:win": "electron-builder --win",
    "dist:linux": "electron-builder --linux"
  },
  "dependencies": {
    "electron-updater": "^6.8.9"
  },
  "devDependencies": {
    "electron": "^37.0.0",
    "electron-builder": "^26.15.3",
    "playwright-core": "^1.62.1"
  },
  "build": {
    "appId": "com.webdeck.app",
    "productName": "WebDeck",
    "asar": true,
    "electronDist": "node_modules/electron/dist",
    "files": [
      "src/**",
      "assets/**",
      "package.json",
      "scripts/demo-server.js"
    ],
    "directories": {
      "output": "dist"
    },
    "publish": {
      "provider": "github",
      "owner": "holyshock31",
      "repo": "webdeck"
    },
    "mac": {
      "icon": "assets/icon.icns",
      "category": "public.app-category.utilities",
      "target": [
        "dmg",
        "zip"
      ]
    },
    "win": {
      "icon": "assets/icon.ico",
      "artifactName": "WebDeck.Setup.${version}.${ext}",
      "target": [
        "nsis",
        "portable"
      ]
    },
    "portable": {
      "artifactName": "WebDeck.${version}.${ext}"
    },
    "linux": {
      "icon": "assets/icon.png",
      "target": [
        "AppImage"
      ],
      "category": "Utility"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "perMachine": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    }
  }
}
